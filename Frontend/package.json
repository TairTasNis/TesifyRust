{
  "name": "tesify-frontend",
  "private": true,
  "version": "26.11.0-dev.14",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test src/pages/Playlist/sorting.test.mjs src/pages/Lyrics/timing.test.mjs",
    "dev": "node ../scripts/dev.mjs",
    "dev:desktop": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "dev:android": "vite --host 127.0.0.1 --port 1420 --strictPort --mode android",
    "desktop:dev": "node ../scripts/desktop.mjs dev",
    "desktop:build": "node ../scripts/desktop.mjs build",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode android",
    "preview": "vite preview --host 127.0.0.1"
  },
  "bin": {
    "run": "../scripts/run-cli.mjs",
    "build": "../scripts/build-cli.mjs",
    "dev": "../scripts/dev-cli.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@tauri-apps/api": "3.0.0-alpha.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "3.0.0-alpha.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
