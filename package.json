{
  "name": "tesify",
  "private": true,
  "version": "26.11.0-dev.18",
  "scripts": {
    "setup:bin": "node scripts/setup-bin.mjs",
    "postinstall": "node scripts/setup-bin.mjs",
    "install:frontend": "npm --prefix Frontend ci && node scripts/setup-bin.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix Frontend run build",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "android:build": "node scripts/desktop.mjs android build --apk --target aarch64 x86_64",
    "desktop:info": "node scripts/desktop.mjs info",
    "desktop:check": "cargo check --manifest-path Backend/Cargo.toml --locked",
    "tauri": "node scripts/desktop.mjs"
  },
  "bin": {
    "run": "./scripts/run-cli.mjs",
    "build": "./scripts/build-cli.mjs",
    "dev": "./scripts/dev-cli.mjs",
    "tauri": "./scripts/desktop.mjs"
  }
}
