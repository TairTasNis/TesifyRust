[Unit]
Description=Tesify Telegram Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/tesify-telegram
EnvironmentFile=/opt/tesify-telegram/.env
ExecStart=/opt/tesify-telegram/venv/bin/uvicorn app:app --host 0.0.0.0 --port 5090
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
